---
import { getImage } from 'astro:assets';
import portafolioRaw from '../../images/portafolio_bg.webp';

const portafolioBg = await getImage({ src: portafolioRaw, format: 'webp', width: 1920 });
---

<section id="trabajos" class="relative py-24 px-6 overflow-hidden" style={`background-image: url(${portafolioBg.src}); background-size: cover; background-position: center;`}>
  <div id="trabajos-overlay" class="absolute inset-0 bg-cornsilk-50/70"></div>
  <div class="relative z-10 max-w-6xl mx-auto">
    <div class="flex flex-col items-center mb-14">
      <span class="text-base bg-olive-leaf-500/30 text-olive-leaf-800 border border-olive-leaf-500/50 rounded-full px-4 py-1 mb-4 uppercase tracking-wider font-semibold">Portafolio</span>
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-center italic relative hover:text-olive-leaf-800 transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:bg-olive-leaf-400 after:scale-x-0 after:origin-center after:transition-transform after:duration-300 hover:after:scale-x-100">Trabajos realizados</h2>
      <p class="text-olive-leaf-700 text-center max-w-xl">
        Aquí iremos publicando los proyectos que construimos junto a nuestros clientes.
        Estamos en nuestros primeros pasos — ¡sé parte de los primeros!
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-6 opacity-40 pointer-events-none select-none">
      {[1, 2, 3].map(() => (
        <div class="bg-cornsilk-100 border border-cornsilk-200 rounded-xl overflow-hidden">
          <div class="h-40 bg-cornsilk-200"></div>
          <div class="p-6">
            <div class="h-3 bg-cornsilk-300 rounded w-1/3 mb-3"></div>
            <div class="h-4 bg-cornsilk-300 rounded w-3/4 mb-2"></div>
            <div class="h-3 bg-cornsilk-200 rounded w-full"></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

