---
import { Image } from 'astro:assets';
import bosqueHero from '../../images/bosque_hero.webp';
---

<section id="hero-section" class="relative min-h-screen flex flex-col items-center justify-center text-center px-6 pt-20 overflow-hidden">
  <Image
    src={bosqueHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
    widths={[800, 1200, 1920]}
    sizes="100vw"
  />
  <div id="hero-overlay" class="absolute inset-0 bg-cornsilk-50/70"></div>

  <div class="relative z-10 flex flex-col items-center">
    <span class="text-base bg-olive-leaf-500/30 text-olive-leaf-800 border border-olive-leaf-500/50 rounded-full px-4 py-1 mb-4 uppercase tracking-wider font-semibold">Chiloé · Partner Tecnológico Local</span>
    <h1 class="text-5xl md:text-7xl font-bold leading-tight mb-6 italic relative transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:bg-olive-leaf-400 after:scale-x-0 after:origin-center after:transition-transform after:duration-300 hover:after:scale-x-100">
      Desarrollo Web,<br/>
      <span class="text-olive-leaf-700">Sin complicaciones.</span>
    </h1>
    <p class="text-olive-leaf-700 text-lg max-w-2xl mb-10 text-justify">
     Diseñamos <span class="text-copperwood-900 font-medium">e-commerce, landing pages y webapps a medida</span>, entregando un servicio de <span class="text-copperwood-900 font-medium">soporte continuo</span> diseñado especialmente para pymes o emprendimientos de<span class="text-copperwood-900 font-medium"> Chiloé y sus alrededores</span>.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="#contacto" class="bg-black-forest-700 hover:bg-black-forest-600 transition-colors px-8 py-3 rounded-lg font-medium text-white">
        Conversemos
      </a>
      <a href="#servicios" class="border border-olive-leaf-400 hover:border-olive-leaf-600 transition-colors px-8 py-3 rounded-lg font-medium text-olive-leaf-800">
        Ver servicios
      </a>
    </div>
  </div>
</section>

