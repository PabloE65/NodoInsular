---
import { getImage } from 'astro:assets';
import contactoRaw from '../../images/contacto.webp';
import instagramIcon from '../../images/redes/instagram.svg';
import tikTokIcon from '../../images/redes/tiktok.svg';
import whatsappIcon from '../../images/redes/whatsapp.svg';

const contactoBg = await getImage({ src: contactoRaw, format: 'webp', width: 1920 });
const whatsappNumber = 'REEMPLAZAR_NUMERO';

const socialLinks = [
  { icon: instagramIcon, href: '#', label: 'Instagram' },
  { icon: tikTokIcon, href: '#', label: 'TikTok' },
];
---

<style>
  .social-button {
    transition: transform 0.3s ease;
  }
  
  .social-button:hover {
    transform: scale(1.15);
  }
</style>

<section id="contacto" class="relative py-24 px-6 overflow-hidden" style={`background-image: url(${contactoBg.src}); background-size: cover; background-position: center;`}>
  <div id="contacto-overlay" class="absolute inset-0 bg-cornsilk-50/70"></div>
  <div class="relative z-10 max-w-6xl mx-auto">
    <h2 class="w-fit mx-auto text-3xl md:text-4xl font-bold mb-8 text-center italic relative hover:text-olive-leaf-800 transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:bg-olive-leaf-400 after:scale-x-0 after:origin-center after:transition-transform after:duration-300 hover:after:scale-x-100">Contáctanos</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <!-- Lado Izquierdo: Formulario -->
      <div class="bg-cornsilk-50 p-8 rounded-lg shadow-lg">
        <h3 class="text-xl font-semibold text-black-forest-950 mb-6">Envíanos tu consulta</h3>
        <form class="space-y-5">
          <div>
            <input
              type="text"
              placeholder="Ej.: María Pérez"
              class="w-full px-4 py-3 border border-olive-leaf-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-olive-leaf-500 text-black-forest-950 placeholder-black-forest-950/50"
            />
          </div>
          <div>
            <input
              type="email"
              placeholder="Ej.: maria@correo.com"
              class="w-full px-4 py-3 border border-olive-leaf-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-olive-leaf-500 text-black-forest-950 placeholder-black-forest-950/50"
            />
          </div>
          <div>
            <select
              class="w-full px-4 py-3 border border-olive-leaf-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-olive-leaf-500 text-black-forest-950"
            >
              <option value="" disabled selected>Tipo de servicio</option>
              <option value="landing-pages">Landing pages</option>
              <option value="sitio-corporativo">Sitio Corporativo</option>
              <option value="ecommerce">Ecommerce</option>
              <option value="consultoria">Consultoria</option>
              <option value="otro">No estoy seguro / otro</option>
            </select>
          </div>
          <div>
            <textarea
              placeholder="Ej.: Hola, estoy interesado en desarrollar un sitio web para mi negocio. Me gustaría conocer más detalles sobre sus servicios."
              rows="4"
              class="w-full px-4 py-3 border border-olive-leaf-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-olive-leaf-500 text-black-forest-950 placeholder-black-forest-950/50 resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full bg-black-forest-700 hover:bg-black-forest-600 transition-colors px-6 py-3 rounded-lg font-medium text-white"
          >
            Enviar Consulta
          </button>
        </form>
      </div>

      <!-- Lado Derecho: Información de Contacto -->
      <div class="flex flex-col items-center">
        <p class="text-olive-leaf-700 mb-8 text-center">
          Potenciemos tu negocio desde el sur con tecnología robusta. Cuéntanos qué necesitas y hacemos equipo para crecer.
        </p>
        <a
          href={`https://wa.me/${whatsappNumber}`}
          class="social-button inline-flex items-center gap-2 bg-black-forest-700 hover:bg-black-forest-600 transition-colors px-8 py-3 rounded-lg font-medium text-white mb-8"
        >
          <img src={whatsappIcon.src} alt="" aria-hidden="true" class="w-6 h-6" />
          Escríbenos por WhatsApp
        </a>
        <p class="text-olive-leaf-500 text-base mb-6 text-center">También puedes encontrarnos en redes sociales.</p>
        
        <!-- Social Media Buttons -->
        <div class="flex gap-4">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              title={link.label}
              class="social-button bg-black-forest-700 hover:bg-black-forest-600 transition-colors p-3 rounded-lg"
            >
              <img
                src={link.icon.src}
                alt={link.label}
                class="w-6 h-6"
              />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
