---
import { getImage } from 'astro:assets';
import contactoRaw from '../../images/contacto.webp';

const contactoBg = await getImage({ src: contactoRaw, format: 'webp', width: 1920 });
---

<section id="contacto" class="relative py-24 px-6 overflow-hidden" style={`background-image: url(${contactoBg.src}); background-size: cover; background-position: center;`}>
  <div id="contacto-overlay" class="absolute inset-0 bg-cornsilk-50/70"></div>
  <div class="relative z-10 max-w-xl mx-auto text-center">
    <div class="flex flex-col items-center mb-4">
      <span class="text-xs bg-olive-leaf-500/30 text-olive-leaf-800 border border-olive-leaf-500/50 rounded-full px-4 py-1 mb-4 uppercase tracking-wider font-semibold">Contacto</span>
      <h2 class="text-3xl md:text-4xl font-bold mb-4 italic relative hover:text-olive-leaf-800 transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:bg-olive-leaf-400 after:scale-x-0 after:origin-center after:transition-transform after:duration-300 hover:after:scale-x-100">¿Conversamos?</h2>
    </div>
    <p class="text-olive-leaf-700 mb-10">
      Potenciemos tu negocio desde el sur con tecnología robusta. Cuéntanos qué necesitas y hacemos equipo para crecer.
    </p>
    <a
      href="mailto:hola@nodoinsular.cl"
      class="inline-block bg-black-forest-700 hover:bg-black-forest-600 transition-colors px-8 py-3 rounded-lg font-medium text-white mb-6"
    >
      hola@nodoinsular.cl
    </a>
    <p class="text-olive-leaf-500 text-sm">También puedes escribirnos por WhatsApp o redes sociales.</p>
  </div>
</section>

