---
import {
  ArrowUpRight,
  Building2,
  ShoppingCart,
} from '@lucide/astro';
import PricingCard from '../ui/PricingCard.astro';
import ServicePlaceholderCard from '../ui/ServicePlaceholderCard.astro';

const landingPlans = [
  {
    name: 'Básica',
    price: '$ 150.000 + IVA',
    theme: 'basic' as const,
    features: [
      'Diseño responsive',
      'Diseño personalizado',
      'Integración WhatsApp',
      'Formulario de contacto',
      'Google Maps',
      'Optimización de imágenes',
      'Soporte técnico',
    ],
  },
  {
    name: 'Pro',
    price: 'Consultar',
    theme: 'pro' as const,
    features: [
      'Todo lo incluido en Básica',
      'Estructura ampliada para más secciones',
      'Configuración SEO inicial',
      'Integración de analítica web',
      'Acompañamiento durante el lanzamiento',
    ],
  },
  {
    name: 'Premium',
    price: 'Consultar',
    theme: 'premium' as const,
    features: [
      'Todo lo incluido en Pro',
      'Diseño y contenido con foco en conversión',
      'Animaciones e interacciones personalizadas',
      'Integraciones adicionales según el proyecto',
      'Soporte prioritario para el lanzamiento',
    ],
  },
];
---

<section id="pricing" class="relative overflow-hidden px-4 py-16 md:px-6 md:py-24">
  <div id="pricing-overlay" class="absolute inset-0 bg-cornsilk-50/70"></div>
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <header class="mb-8 flex flex-col items-center md:mb-14">
      <h2 class="relative mb-4 text-center text-2xl font-bold italic transition-colors after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-center after:scale-x-0 after:bg-olive-leaf-400 after:transition-transform after:duration-300 hover:text-olive-leaf-800 hover:after:scale-x-100 md:text-3xl lg:text-4xl">
        Planes y servicios
      </h2>
    </header>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      <PricingCard id="landing-pricing" category="Landing Pages" title="Para Convertir" plans={landingPlans}>
        <ArrowUpRight slot="icon" size={20} strokeWidth={1.75} />
      </PricingCard>

      <ServicePlaceholderCard category="Sitios web" title="Sitio Corporativo">
        <Building2 slot="icon" size={20} strokeWidth={1.75} />
      </ServicePlaceholderCard>

      <ServicePlaceholderCard category="Tiendas online" title="E-commerce">
        <ShoppingCart slot="icon" size={20} strokeWidth={1.75} />
      </ServicePlaceholderCard>
    </div>
  </div>
</section>
