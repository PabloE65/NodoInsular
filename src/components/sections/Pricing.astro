---
---

<section id="pricing" class="relative py-16 md:py-24 px-4 md:px-6 overflow-hidden">
  <div id="pricing-overlay" class="absolute inset-0 bg-cornsilk-50/70"></div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center mb-8 md:mb-14">
      <span class="text-sm md:text-base bg-olive-leaf-500/30 text-olive-leaf-800 border border-olive-leaf-500/50 rounded-full px-4 py-1 mb-4 uppercase tracking-wider font-semibold">Precios</span>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4 text-center italic relative hover:text-olive-leaf-800 transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:bg-olive-leaf-400 after:scale-x-0 after:origin-center after:transition-transform after:duration-300 hover:after:scale-x-100">Planes y servicios</h2>
      <p class="text-olive-leaf-700 text-sm md:text-base text-center max-w-xl mb-6">
        Sin amarres, ni sorpresas en el presupuesto.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {/* E-commerce & POS */}
      <div class="flex flex-col rounded-2xl bg-gradient-to-b from-olive-leaf-800 to-olive-leaf-700 p-6 md:p-8 border-3 border-cornsilk-500 hover:shadow-lg transition-all">
        <span class="text-xs font-bold uppercase tracking-widest text-cornsilk-300 mb-2">Más solicitado</span>
        <h3 class="text-lg font-bold text-cornsilk-100 mb-2">E-commerce & POS</h3>
        <p class="text-sm text-cornsilk-100 mb-4">Tu tienda online lista para vender.</p>
        <div class="border-t border-olive-leaf-200 my-4"></div>
        <div class="space-y-3 mb-4">
          <div class="flex justify-between items-start bg-cornsilk-50 p-3 rounded-lg">
            <div>
              <p class="text-sm font-semibold text-olive-leaf-800">Shopify / WooCommerce</p>
              <p class="text-xs text-olive-leaf-600">Template + config</p>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-black-forest-950">desde $450.000</p>
              <p class="text-xs text-olive-leaf-600">CLP</p>
            </div>
          </div>
          <div class="flex justify-between items-start bg-cornsilk-50 p-3 rounded-lg">
            <div>
              <p class="text-sm font-semibold text-olive-leaf-800">Tienda a medida</p>
              <p class="text-xs text-olive-leaf-600">Diseño y código</p>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-black-forest-950">desde $1.500.000</p>
              <p class="text-xs text-olive-leaf-600">CLP</p>
            </div>
          </div>
        </div>
        <div class="border-t border-olive-leaf-200 my-4"></div>
        <a href="#contacto" class="group relative inline-flex h-12 items-center justify-center rounded-md bg-black-forest-900 px-6 font-medium text-cornsilk-100 transition-colors mt-auto w-full">
          <span>Cotizar</span>
          <div class="relative ml-1 h-5 w-5 overflow-hidden">
            <div class="absolute transition-all duration-200 group-hover:-translate-y-5 group-hover:translate-x-4">
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5"><path d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 -translate-x-4"><path d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
            </div>
          </div>
        </a>
      </div>

      {/* Sitios web & apps */}
      <div class="flex flex-col rounded-2xl bg-gradient-to-b from-olive-leaf-800 to-olive-leaf-700 p-6 md:p-8 border border-olive-leaf-300 hover:shadow-lg transition-all">
        <h3 class="text-lg font-bold text-cornsilk-100 mb-2">Sitios web & apps</h3>
        <p class="text-sm text-cornsilk-100 mb-4">Landing a web app compleja.</p>
        <div class="border-t border-olive-leaf-200 my-4"></div>
        <div class="space-y-3 mb-4">
          <div class="flex justify-between items-start bg-cornsilk-50 p-3 rounded-lg">
            <div>
              <p class="text-sm font-semibold text-olive-leaf-800">Landing page</p>
              <p class="text-xs text-olive-leaf-600">Una sola página</p>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-black-forest-950">desde $180.000</p>
              <p class="text-xs text-olive-leaf-600">CLP</p>
            </div>
          </div>
          <div class="flex justify-between items-start bg-cornsilk-50 p-3 rounded-lg">
            <div>
              <p class="text-sm font-semibold text-olive-leaf-800">Sitio corporativo</p>
              <p class="text-xs text-olive-leaf-600">Portfolio</p>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-black-forest-950">desde $450.000</p>
              <p class="text-xs text-olive-leaf-600">CLP</p>
            </div>
          </div>
          <div class="flex justify-between items-start bg-cornsilk-50 p-3 rounded-lg">
            <div>
              <p class="text-sm font-semibold text-olive-leaf-800">Web app a medida</p>
              <p class="text-xs text-olive-leaf-600">Funcionalidades</p>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-black-forest-950">a consultar</p>
              <p class="text-xs text-olive-leaf-600">según alcance</p>
            </div>
          </div>
        </div>
        <div class="border-t border-olive-leaf-200 my-4"></div>
        <a href="#contacto" class="group relative inline-flex h-12 items-center justify-center rounded-md bg-black-forest-900 px-6 font-medium text-cornsilk-100 transition-colors mt-auto w-full">
          <span>Cotizar</span>
          <div class="relative ml-1 h-5 w-5 overflow-hidden">
            <div class="absolute transition-all duration-200 group-hover:-translate-y-5 group-hover:translate-x-4">
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5"><path d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 -translate-x-4"><path d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
            </div>
          </div>
        </a>
      </div>

      {/* Asesorías tech */}
      <div class="flex flex-col rounded-2xl bg-gradient-to-b from-olive-leaf-800 to-olive-leaf-700 p-6 md:p-8 border border-olive-leaf-300 hover:shadow-lg transition-all">
        <h3 class="text-lg font-bold text-cornsilk-100 mb-2">Asesorías tech</h3>
        <p class="text-sm text-cornsilk-100 mb-4">Decisiones sin tecnicismos.</p>
        <div class="border-t border-olive-leaf-200 my-4"></div>
        <ul class="space-y-2 mb-4 text-sm">
          <li class="flex gap-2 text-cornsilk-100">
            <span class="text-cornsilk-500 font-bold">✓</span>
            <span>IA aplicada a tu negocio</span>
          </li>
          <li class="flex gap-2 text-cornsilk-100">
            <span class="text-cornsilk-500 font-bold">✓</span>
            <span>Comparativa de herramientas</span>
          </li>
          <li class="flex gap-2 text-cornsilk-100">
            <span class="text-cornsilk-500 font-bold">✓</span>
            <span>Informe escrito incluido</span>
          </li>
          <li class="flex gap-2 text-cornsilk-100">
            <span class="text-cornsilk-500 font-bold">✓</span>
            <span>Sin compromiso</span>
          </li>
        </ul>
        <div class="bg-cornsilk-50 p-3 rounded-lg mb-4">
          <p class="text-sm font-semibold text-olive-leaf-800">Sesión 1 hr</p>
          <p class="text-xs text-olive-leaf-600">Videollamada</p>
          <p class="text-sm font-bold text-black-forest-950 mt-1">$60.000 CLP / hr</p>
        </div>
        <div class="border-t border-olive-leaf-200 my-4"></div>
        <a href="#contacto" class="group relative inline-flex h-12 items-center justify-center rounded-md bg-black-forest-900 px-6 font-medium text-cornsilk-100 transition-colors mt-auto w-full">
          <span>Agendar sesión</span>
          <div class="relative ml-1 h-5 w-5 overflow-hidden">
            <div class="absolute transition-all duration-200 group-hover:-translate-y-5 group-hover:translate-x-4">
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5"><path d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 -translate-x-4"><path d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
            </div>
          </div>
        </a>
      </div>

      {/* Plan mensual */}
      <div class="flex flex-col rounded-2xl bg-gradient-to-b from-olive-leaf-800 to-olive-leaf-700 p-6 md:p-8 border-2 border-cornsilk-500 hover:shadow-lg transition-all">
        <h3 class="text-lg font-bold text-cornsilk-100 mb-2">Plan mensual</h3>
        <p class="text-sm text-cornsilk-100 mb-4">Siempre activo y mejorando.</p>
        <div class="border-t border-olive-leaf-200 my-4"></div>
        <div class="space-y-3 mb-4">
          <div class="flex justify-between items-start bg-cornsilk-50 p-3 rounded-lg">
            <div>
              <p class="text-sm font-semibold text-olive-leaf-800">Básico</p>
              <p class="text-xs text-olive-leaf-600">Mantenimiento + seguridad</p>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-black-forest-950">$90.000</p>
              <p class="text-xs text-olive-leaf-600">CLP / mes</p>
            </div>
          </div>
          <div class="flex justify-between items-start bg-cornsilk-50 p-3 rounded-lg">
            <div>
              <p class="text-sm font-semibold text-olive-leaf-800">Pro</p>
              <p class="text-xs text-olive-leaf-600">+ SEO y contenido</p>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-black-forest-950">$180.000</p>
              <p class="text-xs text-olive-leaf-600">CLP / mes</p>
            </div>
          </div>
          <div class="flex justify-between items-start bg-cornsilk-50 p-3 rounded-lg">
            <div>
              <p class="text-sm font-semibold text-olive-leaf-800">Full</p>
              <p class="text-xs text-olive-leaf-600">+ Ads y reportes</p>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-black-forest-950">$320.000</p>
              <p class="text-xs text-olive-leaf-600">CLP / mes</p>
            </div>
          </div>
        </div>
        <div class="border-t border-olive-leaf-200 my-4"></div>
            <span class="text-cornsilk-100">Todos los planes incluyen acceso a <a class="text-cornsilk-500 after:content-['_↗']" >herramientas</a> de nodo insular</span>
        <a href="#contacto" class="group relative inline-flex h-12 items-center justify-center rounded-md bg-black-forest-900 px-6 font-medium text-cornsilk-100 transition-colors mt-auto w-full">
          <span>Ver planes</span>
          <div class="relative ml-1 h-5 w-5 overflow-hidden">
            <div class="absolute transition-all duration-200 group-hover:-translate-y-5 group-hover:translate-x-4">
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5"><path d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 -translate-x-4"><path d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
            </div>
          </div>
