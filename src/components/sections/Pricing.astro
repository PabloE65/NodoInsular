---
import {
  ArrowUpRight,
  Building2,
  ClipboardList,
  Headset,
  Image,
  MapPin,
  MessageCircle,
  Palette,
  ShoppingCart,
  Smartphone,
} from '@lucide/astro';
---

<section id="pricing" class="relative overflow-hidden px-4 py-16 md:px-6 md:py-24">
  <div id="pricing-overlay" class="absolute inset-0 bg-cornsilk-50/70"></div>
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <header class="mb-8 flex flex-col items-center md:mb-14">
      <h2 class="relative mb-4 text-center text-2xl font-bold italic transition-colors after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-center after:scale-x-0 after:bg-olive-leaf-400 after:transition-transform after:duration-300 hover:text-olive-leaf-800 hover:after:scale-x-100 md:text-3xl lg:text-4xl">
        Planes y servicios
      </h2>
    </header>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      <article class="flex flex-col rounded-2xl border-2 border-cornsilk-500 bg-gradient-to-b from-black-forest-800 to-black-forest-700 p-6 shadow-lg shadow-black-forest-900/10 transition-shadow hover:shadow-xl md:p-8">
        <div class="mb-6 flex items-center gap-3">
          <span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-black-forest-600 text-cornsilk-200">
            <ArrowUpRight size={20} strokeWidth={1.75} />
          </span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-cornsilk-300">Páginas web</p>
            <h3 class="text-lg font-bold text-cornsilk-50">Landing Básica</h3>
          </div>
        </div>

        <div class="mb-6 rounded-xl bg-black-forest-900/40 p-4">
          <p class="text-sm text-cornsilk-200">Inversión</p>
          <p class="mt-1 text-3xl font-bold tracking-tight text-cornsilk-50">$ 150.000</p>
        </div>

        <ul class="mb-8 space-y-3 text-sm text-cornsilk-100">
          <li class="flex items-start gap-3">
            <Smartphone size={16} strokeWidth={1.75} aria-hidden="true" class="mt-0.5 shrink-0 text-cornsilk-300" />
            <span>Diseño responsive</span>
          </li>
          <li class="flex items-start gap-3">
            <Palette size={16} strokeWidth={1.75} aria-hidden="true" class="mt-0.5 shrink-0 text-cornsilk-300" />
            <span>Diseño personalizado</span>
          </li>
          <li class="flex items-start gap-3">
            <MessageCircle size={16} strokeWidth={1.75} aria-hidden="true" class="mt-0.5 shrink-0 text-cornsilk-300" />
            <span>Integración WhatsApp</span>
          </li>
          <li class="flex items-start gap-3">
            <ClipboardList size={16} strokeWidth={1.75} aria-hidden="true" class="mt-0.5 shrink-0 text-cornsilk-300" />
            <span>Formulario de contacto</span>
          </li>
          <li class="flex items-start gap-3">
            <MapPin size={16} strokeWidth={1.75} aria-hidden="true" class="mt-0.5 shrink-0 text-cornsilk-300" />
            <span>Google Maps</span>
          </li>
          <li class="flex items-start gap-3">
            <Image size={16} strokeWidth={1.75} aria-hidden="true" class="mt-0.5 shrink-0 text-cornsilk-300" />
            <span>Optimización de imágenes</span>
          </li>
          <li class="flex items-start gap-3">
            <Headset size={16} strokeWidth={1.75} aria-hidden="true" class="mt-0.5 shrink-0 text-cornsilk-300" />
            <span>Soporte técnico</span>
          </li>
        </ul>

        <a
          href="#contacto"
          class="mt-auto inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-cornsilk-100 px-5 py-3 font-semibold text-black-forest-900 transition-colors hover:bg-cornsilk-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cornsilk-100"
        >
          <MessageCircle size={18} strokeWidth={1.75} aria-hidden="true" />
          Contactar por WhatsApp
        </a>
      </article>

      <article class="flex flex-col rounded-2xl border border-olive-leaf-200 bg-cornsilk-50/80 p-6 shadow-lg shadow-black-forest-900/5 md:p-8">
        <div class="mb-6 flex items-center gap-3">
          <span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-olive-leaf-100 text-black-forest-700">
            <Building2 size={20} strokeWidth={1.75} />
          </span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-olive-leaf-700">Sitios web</p>
            <h3 class="text-lg font-bold text-black-forest-900">Sitio Corporativo</h3>
          </div>
        </div>
        <div class="flex flex-1 flex-col items-center justify-center rounded-xl border border-dashed border-olive-leaf-300 bg-olive-leaf-50/70 p-6 text-center">
          <p class="text-sm font-semibold text-olive-leaf-800">Próximamente</p>
          <p class="mt-2 max-w-xs text-sm leading-relaxed text-olive-leaf-700">
            Estamos preparando los detalles de este servicio.
          </p>
        </div>
      </article>

      <article class="flex flex-col rounded-2xl border border-olive-leaf-200 bg-cornsilk-50/80 p-6 shadow-lg shadow-black-forest-900/5 md:p-8">
        <div class="mb-6 flex items-center gap-3">
          <span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-olive-leaf-100 text-black-forest-700">
            <ShoppingCart size={20} strokeWidth={1.75} />
          </span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-olive-leaf-700">Tiendas online</p>
            <h3 class="text-lg font-bold text-black-forest-900">E-commerce</h3>
          </div>
        </div>
        <div class="flex flex-1 flex-col items-center justify-center rounded-xl border border-dashed border-olive-leaf-300 bg-olive-leaf-50/70 p-6 text-center">
          <p class="text-sm font-semibold text-olive-leaf-800">Próximamente</p>
          <p class="mt-2 max-w-xs text-sm leading-relaxed text-olive-leaf-700">
            Estamos preparando los detalles de este servicio.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>
