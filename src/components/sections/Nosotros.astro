---
import { Image } from 'astro:assets';
import senderoHero from '../../images/sendero_hero.webp';
---

<section id="nosotros" class="relative py-24 px-6 overflow-hidden">
  <Image
    src={senderoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
    widths={[800, 1200, 1920]}
    sizes="100vw"
  />
  <div id="nosotros-overlay" class="absolute inset-0 bg-cornsilk-50/85"></div>
  <div class="relative z-10 max-w-5xl mx-auto">
    <p class="text-olive-leaf-600 text-sm uppercase tracking-widest text-center mb-3">Nosotros</p>
    <h2 class="text-3xl md:text-4xl font-bold mb-10 text-center">¿cómo trabajamos?</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

      <!-- Card principal — col-span-2 -->
      <div class="md:col-span-2 bg-olive-leaf-800 text-cornsilk-50 rounded-2xl p-8 flex flex-col justify-between gap-6">
        <div>
          <p class="text-olive-leaf-400 text-xs uppercase tracking-widest mb-4">Nuestra filosofía</p>
          <p class="text-lg leading-relaxed mb-4">
            Gracias al avance tecnológico y el impacto de la Inteligencia Artificial, los procesos de
            creación y mantención de software se han vuelto más rápidos, dinámicos y accesibles.
          </p>
          <p class="text-cornsilk-200 leading-relaxed">
            En <span class="font-bold text-cornsilk-50">Nodo Insular</span> aprovechamos esta democratización tecnológica para ofrecer un servicio personalizado, a largo plazo con un diagnóstico cercano, desarrollo dinámico con feedback directo y
            <span class="font-bold text-cornsilk-50">acompañamiento real tras el lanzamiento</span>. Buscamos ser tu partner tecnológico.
          </p>
        </div>
      </div>

      <!-- 1 mes soporte -->
      <div class="bg-cornsilk-50 border border-cornsilk-300 rounded-2xl p-6 flex flex-col justify-center items-center text-center gap-2">
        <div class="text-2xl font-bold text-olive-leaf-600">1 mes</div>
        <div class="text-olive-leaf-700 text-sm leading-snug">Soporte gratuito una vez entregado el proyecto</div>
      </div>

      <!-- 100% código propio -->
      <div class="bg-copperwood-100 border border-copperwood-200 rounded-2xl p-6 flex flex-col justify-center items-center text-center gap-2">
        <div class="text-2xl font-bold text-copperwood-700">100%</div>
        <div class="text-copperwood-700 text-sm leading-snug">Todo el Código que desarrollamos es de tu propiedad. Si decides migrar o cambiar de proveedor, te llevas tu código. Sin letras chicas.</div>
      </div>

      <!-- Local -->
      <div class="bg-black-forest-800 rounded-2xl p-6 flex flex-col justify-center items-center text-center gap-2">
        <div class="text-2xl font-bold text-black-forest-300">Integraciones</div>
        <div class="text-black-forest-200 text-sm leading-snug">Botones de Whatsapp, Pasarelas de pago, redes sociales, Inteligencia artificial.</div>
      </div>

      <!-- IA -->
      <div class="bg-olive-leaf-600 rounded-2xl p-6 flex flex-col justify-center items-center text-center gap-2">
        <div class="text-2xl font-bold text-cornsilk-200">Documentación</div>
        <div class="text-olive-leaf-100 text-sm leading-snug">Generamos documentación completa del todo el proceso, te entregamos manuales de uso, tips, y mejores prácticas para que puedas aprovechar al máximo tu solución tecnológica.</div>
      </div>

    </div>
  </div>
</section>

<script>
  const nosotrosSection = document.getElementById('nosotros')!;
  const nosotrosOverlay = document.getElementById('nosotros-overlay')!;
  const RADIUS = 220;

  nosotrosSection.addEventListener('mousemove', (e) => {
    const rect = nosotrosSection.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    const mask = `radial-gradient(circle ${RADIUS}px at ${x}px ${y}px, transparent 0%, black 100%)`;
    nosotrosOverlay.style.maskImage = mask;
    (nosotrosOverlay.style as any).webkitMaskImage = mask;
  });

  nosotrosSection.addEventListener('mouseleave', () => {
    nosotrosOverlay.style.maskImage = '';
    (nosotrosOverlay.style as any).webkitMaskImage = '';
  });
</script>
