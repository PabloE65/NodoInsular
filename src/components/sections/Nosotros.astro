---
---

<section id="nosotros" class="relative py-24 px-6 overflow-hidden">
  <div id="nosotros-overlay" class="absolute inset-0 bg-cornsilk-50/70"></div>
  <div class="relative z-10 max-w-5xl mx-auto">

    <!-- Header -->
    <div class="flex flex-col items-center mb-10">
      <span class="text-sm bg-olive-leaf-500/30 text-olive-leaf-800 border border-olive-leaf-500/50 rounded-full px-4 py-1 mb-4 uppercase tracking-wider font-semibold">
        Nosotros
      </span>
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-center italic relative hover:text-olive-leaf-800 transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:bg-olive-leaf-400 after:scale-x-0 after:origin-center after:transition-transform after:duration-300 hover:after:scale-x-100">
        ¿cómo trabajamos?
      </h2>
    </div>

    <!-- Split layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">

      <!-- Columna izquierda: Filosofía -->
      <div class="text-olive-leaf-950 rounded-2xl p-8 flex flex-col gap-6 h-full">
        <p class="text-olive-leaf-950 text-base uppercase tracking-widest font-semibold">
          Nuestra filosofía
        </p>
        <div class="flex flex-col gap-4 flex-1">
          <p class="text-lg leading-relaxed">
            El avance de la Inteligencia Artificial está modificando todos los procesos de desarrollo tecnológico, ayudando a la democratización de
            <span class="font-bold text-olive-leaf-800">soluciones digitales</span>,
            pero también existen desafíos asociados a seguridad, privacidad y ética.
          </p>
          <p class="leading-relaxed text-olive-leaf-900">
            En <span class="font-bold text-olive-leaf-800">Nodo Insular</span> abordamos estos desafíos junto a ti y ofrecemos un
            <span class="font-bold text-olive-leaf-800">acompañamiento real tras el lanzamiento</span>.
            Buscamos ser tu partner tecnológico.
          </p>
        </div>
        <div class="pt-4 border-t border-olive-leaf-300">
          <span class="text-sm text-olive-leaf-700 font-medium tracking-wide">
            Tu partner tecnológico →
          </span>
        </div>
      </div>

      <!-- Columna derecha: 5 pilares -->
      <div class="flex flex-col">

        <!-- 01 Ley 21.719 -->
        <div class="flex items-center gap-4 py-4 border-t border-olive-leaf-800/20 group">
          <span class="font-serif italic text-3xl text-olive-leaf-700/90 w-10 text-right shrink-0 leading-none select-none">
            01
          </span>
          <div class="w-9 h-9 bg-black-forest-700 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-cornsilk-200" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <div>
            <p class="text-base font-semibold text-olive-leaf-900">Ley 21.719</p>
            <p class="text-sm text-olive-leaf-950 leading-snug mt-0.5">
              Nuestras soluciones cumplen con la ley para garantizar la protección de tus datos y privacidad.
            </p>
          </div>
        </div>

        <!-- 02 Código de tu propiedad -->
        <div class="flex items-center gap-4 py-4 border-t border-olive-leaf-800/20 group">
          <span class="font-serif italic text-3xl text-olive-leaf-700/90 w-10 text-right shrink-0 leading-none select-none">
            02
          </span>
          <div class="w-9 h-9 bg-black-forest-700 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-cornsilk-200" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
            </svg>
          </div>
          <div>
            <p class="text-base font-semibold text-olive-leaf-900">Código de tu propiedad</p>
            <p class="text-sm text-olive-leaf-950 leading-snug mt-0.5">
              El código es 100% tuyo. Si decides cambiar de proveedor, te lo llevas completamente documentado. Sin letras chicas.
            </p>
          </div>
        </div>

        <!-- 03 Documentación -->
        <div class="flex items-center gap-4 py-4 border-t border-olive-leaf-800/20 group">
          <span class="font-serif italic text-3xl text-olive-leaf-700/90 w-10 text-right shrink-0 leading-none select-none">
            03
          </span>
          <div class="w-9 h-9 bg-black-forest-700 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-cornsilk-200" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
          </div>
          <div>
            <p class="text-base font-semibold text-olive-leaf-900">Documentación completa</p>
            <p class="text-sm text-olive-leaf-950 leading-snug mt-0.5">
              Manuales de uso, tips y mejores prácticas para que aproveches al máximo tu solución.
            </p>
          </div>
        </div>

        <!-- 04 Sin lock-in -->
        <div class="flex items-center gap-4 py-4 border-t border-olive-leaf-800/20 group">
          <span class="font-serif italic text-3xl text-olive-leaf-700/90 w-10 text-right shrink-0 leading-none select-none">
            04
          </span>
          <div class="w-9 h-9 bg-black-forest-700 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-cornsilk-200" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 119 0v3.75M3.75 21.75h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H3.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <div>
            <p class="text-base font-semibold text-olive-leaf-900">Sin lock-in tecnológico</p>
            <p class="text-sm text-olive-leaf-950 leading-snug mt-0.5">
              En el proceso de diseño siempre intentamos dejar la menor dependencia posible de proveedores críticos.
            </p>
          </div>
        </div>

        <!-- 05 Proceso visible -->
        <div class="flex items-center gap-4 py-4 border-t border-b border-olive-leaf-800/20 group">
          <span class="font-serif italic text-3xl text-olive-leaf-700/90 w-10 text-right shrink-0 leading-none select-none">
            05
          </span>
          <div class="w-9 h-9 bg-black-forest-700 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-cornsilk-200" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <p class="text-base font-semibold text-olive-leaf-900">Proceso visible</p>
            <p class="text-sm text-olive-leaf-950 leading-snug mt-0.5">
              Acceso al repositorio, ambiente de staging y actualizaciones periódicas. Sin cajas negras.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

