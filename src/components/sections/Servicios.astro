---
import shopIcon from '../../images/redes/shop.svg';
import webIcon from '../../images/redes/web.svg';
import asesoriaIcon from '../../images/redes/asesoria.svg';
import subsIcon from '../../images/redes/subs.svg';

const servicios = [
  {
    title: 'E-commerce & Punto de Venta',
    desc: 'E-commerce robusto, rápido y seguro. Shopify, WooCommerce y tiendas a medida para que vendas sin límites.',
    icon: shopIcon,
  },
  {
    title: 'WebApps a Medida',
    desc: 'Sitios corporativos, landing pages, portafolios y soluciones personalizadas. Tu presencia digital, bien construida.',
    icon: webIcon,
  },
  {
    title: 'Asesorías Tecnológicas',
    desc: 'IA aplicada a tu negocio, comparativa de herramientas y orientación clara. Toma mejores decisiones.',
    icon: asesoriaIcon,
  },
  {
    title: 'Servicios Recurrentes',
    desc: 'Mantenimiento técnico, seguridad, SEO, gestión de contenido y campañas publicitarias. Tu sitio siempre activo.',
    icon: subsIcon,
  },
];

const techs = [
  { name: "Shopify",      bg: "#96BF48", color: "#fff", label: "SH" },
  { name: "WooCommerce",  bg: "#7F54B3", color: "#fff", label: "WC" },
  { name: "Mercado Pago", bg: "#00AEEF", color: "#fff", label: "MP" },
  { name: "Webpay",       bg: "#E4151B", color: "#fff", label: "WP" },
  { name: "Flow",         bg: "#1E3A5F", color: "#fff", label: "FL" },
  { name: "Bsale",        bg: "#F47B20", color: "#fff", label: "BS" },
];
const doubled = [...techs, ...techs];
---

<section id="servicios" class="relative py-24 px-6 overflow-hidden">
  <div id="servicios-overlay" class="absolute inset-0 bg-cornsilk-50/70"></div>
  <div class="relative z-10 max-w-6xl mx-auto">
    <div class="flex flex-col items-center mb-8">
      <span class="text-sm bg-olive-leaf-500/30 text-olive-leaf-800 border border-olive-leaf-500/50 rounded-full px-4 py-1 mb-4 uppercase tracking-wider font-semibold">Servicios</span>
      <h2 class="text-3xl md:text-4xl font-bold mb-1 text-center italic relative hover:text-olive-leaf-800 transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:bg-olive-leaf-400 after:scale-x-0 after:origin-center after:transition-transform after:duration-300 hover:after:scale-x-100">Todo lo que necesitas para tu proyecto</h2>
    </div>
    <p class="text-olive-leaf-950 text-center max-w-2xl mx-auto mb-14">
      Ofrecemos distintas soluciones para potenciar tu presencia digital. Desde tiendas online hasta asesorías tecnológicas. Nuestro objetivo es convertirnos en tu socio técnico y que te enfoques en lo que mejor haces, tu negocio. 
    </p>
    <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {servicios.map(s => (
        <div class="relative pl-16">
          <dt class="text-base font-semibold text-olive-leaf-950">
            <div class="service-icon-button absolute top-0 left-0 flex size-12 items-center justify-center rounded-lg bg-black-forest-700 hover:bg-black-forest-600 transition-colors p-2">
              <img
                src={s.icon.src}
                alt={s.title}
                class="w-full h-full"
              />
            </div>
            {s.title}
          </dt>
          <dd class="mt-2 text-base text-olive-leaf-950">{s.desc}</dd>
        </div>
      ))}
    </div>
  </div>

  <div class="py-3 rounded-xl max-w-4xl mx-auto mt-16" style="background:#fefbe6">
  <div class="relative overflow-hidden">

    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-24 z-10"
         style="background:linear-gradient(to right,#fefbe6,transparent)"></div>
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-24 z-10"
         style="background:linear-gradient(to left,#fefbe6,transparent)"></div>

    <div class="flex items-center w-max animate-scroll-left hover:[animation-play-state:paused]">
      {doubled.map((t) => (
        <div class="flex items-center gap-2 px-9">
          <div
            class="w-7 h-7 rounded-[7px] flex items-center justify-center
                   text-[10px] font-extrabold font-mono shrink-0"
            style={`background:${t.bg};color:${t.color}`}
          >
            {t.label}
          </div>
          <span class="text-[13px] font-semibold text-gray-900 whitespace-nowrap">
            {t.name}
          </span>
        </div>
      ))}
    </div>

  </div>
</div>
</section>

