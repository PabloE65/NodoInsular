---
import shopIcon from '../../images/redes/shop.svg';
import webIcon from '../../images/redes/web.svg';
import asesoriaIcon from '../../images/redes/asesoria.svg';
import subsIcon from '../../images/redes/subs.svg';

const servicios = [
  {
    title: 'Landings y páginas Corporativas',
    desc: 'Landings enfocadas en conversión y sitios web corporativos modernos.',
    icon: shopIcon,
  },
  {
    title: 'WebApps a Medida',
    desc: 'Aplicaciones web personalizadas para resolver tus necesidades específicas.',
    icon: webIcon,
  },
  {
    title: 'Asesorías Tecnológicas',
    desc: 'Necesitas orientación para tomar decisiones informadas sobre tu estrategia digital.',
    icon: asesoriaIcon,
  },
  {
    title: 'Servicios Recurrentes',
    desc: 'Mantenimiento técnico, seguridad, SEO, gestión de contenido y campañas publicitarias. Tu sitio siempre activo.',
    icon: subsIcon,
  },
];
---

<section id="servicios" class="relative overflow-hidden px-6 py-24">
  <div id="servicios-overlay" class="absolute inset-0 bg-cornsilk-50/70"></div>
  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="mb-8 flex flex-col items-center">
      <h2 class="relative mb-1 text-center text-3xl font-bold italic transition-colors after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-center after:scale-x-0 after:bg-olive-leaf-400 after:transition-transform after:duration-300 hover:text-olive-leaf-800 hover:after:scale-x-100 md:text-4xl">
        ¿Qué necesitas para tu proyecto?
      </h2>
    </div>
    <div
      data-service-switcher
      class="grid overflow-hidden rounded-2xl border border-olive-leaf-200 bg-cornsilk-50 shadow-xl shadow-black-forest-900/10 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.7fr)]"
    >
      <div class="border-b border-olive-leaf-200 bg-olive-leaf-100/70 p-4 md:border-b-0 md:border-r md:p-6">
        <p class="mb-4 px-2 text-xs font-bold uppercase tracking-[0.18em] text-olive-leaf-700">
          Nuestros servicios
        </p>
        <div role="tablist" aria-label="Servicios disponibles" class="grid grid-cols-2 gap-2 md:grid-cols-1">
          {servicios.map((s, index) => (
            <button
              id={`servicio-tab-${index}`}
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`servicio-panel-${index}`}
              tabindex={index === 0 ? 0 : -1}
              data-service-tab
              class="group flex min-h-20 items-center gap-3 rounded-xl border border-transparent p-3 text-left text-olive-leaf-900 transition-colors hover:border-olive-leaf-300 hover:bg-cornsilk-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black-forest-700 aria-selected:border-black-forest-700 aria-selected:bg-black-forest-700 aria-selected:text-cornsilk-50 md:p-4"
            >
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-cornsilk-50 p-2 transition-colors group-aria-selected:bg-black-forest-600">
                <img src={s.icon.src} alt="" class="h-full w-full" />
              </span>
              <span class="text-sm font-semibold leading-snug md:text-base">{s.title}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="flex min-h-80 items-center p-6 md:p-10">
        {servicios.map((s, index) => (
          <article
            id={`servicio-panel-${index}`}
            role="tabpanel"
            aria-labelledby={`servicio-tab-${index}`}
            tabindex="0"
            hidden={index !== 0}
            class="w-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black-forest-700"
          >
            <span class="mb-6 inline-flex size-14 items-center justify-center rounded-2xl bg-olive-leaf-100 p-3">
              <img src={s.icon.src} alt="" class="h-full w-full" />
            </span>
            <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-olive-leaf-700">
              Servicio {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="mb-4 text-2xl font-bold leading-tight text-black-forest-900 md:text-3xl">
              {s.title}
            </h3>
            <p class="mb-8 max-w-xl text-base leading-relaxed text-olive-leaf-900 md:text-lg">
              {s.desc}
            </p>
            <a
              href="#contacto"
              class="inline-flex items-center gap-2 rounded-lg bg-black-forest-700 px-5 py-3 font-semibold text-cornsilk-50 transition-colors hover:bg-black-forest-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black-forest-700"
            >
              Hablemos de tu proyecto
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-service-switcher]').forEach((switcher) => {
    const tabs = Array.from(switcher.querySelectorAll<HTMLButtonElement>('[data-service-tab]'));
    const panels = Array.from(switcher.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const activateTab = (index: number, moveFocus = false) => {
      tabs.forEach((tab, tabIndex) => {
        const isSelected = tabIndex === index;
        tab.setAttribute('aria-selected', String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
        panels[tabIndex].hidden = !isSelected;
      });

      if (moveFocus) tabs[index].focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(index));
      tab.addEventListener('keydown', (event) => {
        let nextIndex: number | undefined;

        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          nextIndex = (index + 1) % tabs.length;
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = tabs.length - 1;
        }

        if (nextIndex !== undefined) {
          event.preventDefault();
          activateTab(nextIndex, true);
        }
      });
    });
  });
</script>
