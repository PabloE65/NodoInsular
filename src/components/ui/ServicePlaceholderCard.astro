---
interface Props {
  category: string;
  title: string;
}

const { category, title } = Astro.props;
---

<article class="flex flex-col rounded-2xl border border-olive-leaf-200 bg-cornsilk-50/80 p-6 shadow-lg shadow-black-forest-900/5 md:p-8">
  <div class="mb-6 flex items-center gap-3">
    <span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-olive-leaf-100 text-black-forest-700">
      <slot name="icon" />
    </span>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-olive-leaf-700">{category}</p>
      <h3 class="text-lg font-bold text-black-forest-900">{title}</h3>
    </div>
  </div>
  <div class="flex flex-1 flex-col items-center justify-center rounded-xl border border-dashed border-olive-leaf-300 bg-olive-leaf-50/70 p-6 text-center">
    <p class="text-sm font-semibold text-olive-leaf-800">Próximamente</p>
    <p class="mt-2 max-w-xs text-sm leading-relaxed text-olive-leaf-700">
      Estamos preparando los detalles de este servicio.
    </p>
  </div>
</article>
